{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Hephaisto chart values",
  "description": "Structural guards for the values whose failure mode is silence rather than an error.",
  "type": "object",
  "required": [
    "image",
    "mode",
    "observabilityNamespace",
    "prometheusOperator",
    "policy",
    "secrets",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty means .Chart.AppVersion, which CI stamps from the git tag. An OCI tag can never contain '+'.",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "description": "The env arm of the kill switch. The ConfigMap and database arms are the other two, and the most restrictive wins.",
      "enum": [
        "Off",
        "Observe",
        "DryRun",
        "Auto"
      ]
    },
    "incidents": {
      "type": "object",
      "description": "When an incident ends without anybody touching it.",
      "required": [
        "healedAfter",
        "sweep"
      ],
      "properties": {
        "healedAfter": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
          "description": "hh:mm:ss a workload runs cleanly before the watcher reports it healed. 00:00:00 turns that off."
        },
        "sweep": {
          "type": "object",
          "required": [
            "enabled",
            "expireAfter",
            "approvalTimeout"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "expireAfter": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}$",
              "description": "A .NET TimeSpan, d.hh:mm:ss."
            },
            "approvalTimeout": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}$",
              "description": "A .NET TimeSpan, d.hh:mm:ss."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observabilityNamespace": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "description": "AGPL section 13. Empty means upstream; set it to your own source if you run a modified build others can reach.",
      "type": "string"
    },
    "prometheusOperator": {
      "type": "object",
      "required": [
        "selectorLabels"
      ],
      "properties": {
        "selectorLabels": {
          "description": "Must match your Prometheus's podMonitorSelector and ruleSelector. Required and non-empty because the failure mode of getting it wrong is total silence: every object is created, nothing is ever selected, and the agent reports itself healthy.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "actionableNamespaces"
      ],
      "properties": {
        "actionableNamespaces": {
          "description": "Namespaces the agent may act in. Empty means nowhere. kube-*, default, the release namespace and observabilityNamespace are refused at render time. Each must also carry the label hephaisto.dev/destructive-actions-allowed=true, which the policy engine checks.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoEnabledActionTypes": {
          "description": "Action types that may execute without a human, and only in Auto mode. Empty means everything waits for approval. Promote one type at a time.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "RestartPod",
              "RolloutRestart",
              "RollbackDeployment",
              "ScaleWorkload",
              "DeleteStuckJob",
              "DeleteFailedJobPods",
              "SilenceAlert",
              "PatchResources",
              "CordonNode",
              "DrainNode"
            ]
          }
        },
        "rollbackFreshRevisionWindow": {
          "type": "string",
          "description": "A revision younger than this counts as a fresh deploy, so rolling back is admissible. .NET TimeSpan (hh:mm:ss), not Go duration. Widening this is the dangerous direction.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        },
        "rollbackPreviousHealthyMinimum": {
          "type": "string",
          "description": "How long the previous revision must have been healthy before the agent may roll back onto it unattended. .NET TimeSpan (hh:mm:ss), not Go duration.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        },
        "clusterUnhealthyCeiling": {
          "type": "number",
          "description": "Above this fraction of unhealthy pods everything escalates as a cluster-wide event. The e2e --full gate crosses this deliberately; the fix for that is a separate acting run, not a wider ceiling.",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "required": [
        "postgres",
        "llm"
      ],
      "description": "Names of Secrets you create. This chart has no Secret template and will not grow one.",
      "properties": {
        "postgres": {
          "type": "string",
          "minLength": 1
        },
        "llm": {
          "type": "string",
          "minLength": 1
        },
        "grafanaMcp": {
          "type": "string"
        },
        "grafanaAnnotation": {
          "type": "string"
        },
        "notificationWebhook": {
          "type": "string"
        },
        "notificationTeams": {
          "type": "string"
        },
        "notificationTeamsBot": {
          "type": "string",
          "description": "Secret holding the Teams bot's client secret under key `clientSecret`. Required when notifications.teamsBot.enabled is true."
        },
        "auth": {
          "type": "string",
          "description": "Secret holding the OIDC client secret under key `clientSecret`. Required when auth.enabled is true."
        },
        "codeFix": {
          "type": "string",
          "description": "Secret in codeFix.namespace (NOT the release namespace) with keys CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY, GITHUB_TOKEN, NUGET_GITHUB_TOKEN, each optional. Required when codeFix.enabled. Hephaisto never reads it."
        },
        "webhookToken": {
          "type": "string",
          "description": "Secret holding the bearer token /webhooks requires, under key `token` (at least 16 characters). Empty requires none."
        },
        "mcp": {
          "type": "string",
          "description": "Secret holding the MCP endpoint's tokens: one key per mcp.tokens[].name, each at least 32 characters. Required when mcp.tokens is not empty."
        },
        "github": {
          "type": "string",
          "description": "Secret in the RELEASE namespace holding the agent's GitHub token under key `GITHUB_TOKEN`. Required when github.enabled is true. Never the same name as secrets.codeFix."
        }
      },
      "additionalProperties": false
    },
    "grafanaMcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "datasourceUids": {
          "type": "object",
          "description": "Datasource name -> uid, put into the environment card so the agent does not spend a tool call discovering them. Free-form: the names are yours.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLogSelector": {
          "type": "string",
          "pattern": "^$|^\\{.*<pod>.*\\}$",
          "description": "A LogQL stream selector for one pod's logs, with <namespace> and <pod> as placeholders. Set, the model reads pod logs in Loki first."
        }
      },
      "additionalProperties": false
    },
    "alertmanager": {
      "type": "object",
      "description": "Write-only, and the only thing written is a silence. Alerts arrive by webhook.",
      "properties": {
        "url": {
          "type": "string"
        },
        "maxDuration": {
          "type": "string",
          "description": ".NET TimeSpan (hh:mm:ss), not Go duration. \"2h\" does not parse and the agent would fail to start.",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "description": "Outbound delivery. Nothing is on until routes is non-empty AND a channel is configured.",
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "The externally reachable URL of this Hephaisto. Required once any route exists; the pod cannot discover it."
        },
        "grafanaUrl": {
          "type": "string"
        },
        "webhook": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        "teams": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "teamsBot": {
          "type": "object",
          "description": "Microsoft Teams through a registered bot: one board in a channel, edited in place, and alerts by personal chat. It never deletes.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tenantId": {
              "type": "string",
              "description": "The Microsoft Entra tenant id. Required when enabled."
            },
            "appId": {
              "type": "string",
              "description": "The bot's Microsoft App ID. Not a secret. Required when enabled."
            },
            "channelId": {
              "type": "string",
              "description": "The channel holding the board, as 19:...@thread.tacv2. Required when enabled."
            },
            "teamId": {
              "type": "string",
              "description": "The team's group id. Optional; builds the link from an alert to the board."
            },
            "recipients": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 3
              },
              "description": "Work email addresses that receive alerts by personal chat."
            },
            "board": {
              "type": "object",
              "properties": {
                "maxIncidents": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              },
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "description": "Buttons that act on an alert (Acknowledge, Assign to me, Reinvestigate; Close for the approvers named; Approve and Deny with approvals.enabled). Creates the one inbound route Microsoft calls, POST /api/teams/messages, on its own port.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "The port the route answers on, and the only thing that does. Not 8080 and not webhookPort."
                },
                "approvers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "description": "Who holds the approver role in Teams, as Microsoft Entra object ids (GUIDs). Empty means nobody: Close is not drawn and is refused."
                },
                "approvals": {
                  "type": "object",
                  "description": "Approve and Deny of a proposed action from the card. Its own switch; refused without actions.enabled and without an approver.",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "events"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "webhook",
                  "teams",
                  "teamsBot"
                ],
                "description": "Must name a configured channel, or startup validation refuses it."
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "IncidentOpened",
                    "IncidentEscalated",
                    "ApprovalRequired",
                    "IncidentResolved",
                    "VerificationFailed",
                    "ModeChanged",
                    "PolicyChanged",
                    "CodeFixPlanReady",
                    "CodeFixPrOpened",
                    "CodeFixFailed"
                  ]
                }
              },
              "minSeverity": {
                "type": "string",
                "enum": [
                  "Info",
                  "Warning",
                  "Critical"
                ]
              },
              "namespaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "matchers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "values"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "clusters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "fallback": {
                "type": "boolean"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "after"
                  ],
                  "properties": {
                    "after": {
                      "type": "string",
                      "pattern": "^(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}$"
                    },
                    "minSeverity": {
                      "type": "string",
                      "enum": [
                        "Info",
                        "Warning",
                        "Critical"
                      ]
                    },
                    "channel": {
                      "type": "string",
                      "enum": [
                        "webhook",
                        "teams",
                        "teamsBot"
                      ]
                    },
                    "recipients": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "toAssignee": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "maxPerChannelPerHour": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "codeFix": {
      "type": "object",
      "description": "The code-fix stage (v0.9.0): a coder Job plans, and after human approval implements, a fix as a Draft PR. Nothing renders unless enabled; mode is its own axis, independent of the agent's mode.",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "namespace"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Renders the coder infrastructure. False renders nothing code-fix related except codeFixMode: off in the switch ConfigMap."
        },
        "mode": {
          "enum": [
            "off",
            "plan",
            "pr",
            "Off",
            "Plan",
            "Pr"
          ],
          "description": "off | plan | pr. QUOTE it in YAML: a bare off is the boolean false. pr requires auth.enabled (or allowUnauthenticatedApproval)."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "Where coder Jobs run and where the secrets.codeFix Secret lives. Refused at render time if it is default, kube-*, the release namespace, observabilityNamespace or an actionable namespace."
        },
        "createNamespace": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "description": "The coder image. Empty tag means .Chart.AppVersion.",
          "required": [
            "repository"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "contextRepository": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^$|^https?://",
              "description": "The dev-context repository, cloned at ref at the start of every Job."
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repositories": {
          "type": "array",
          "description": "The authorization list: workload -> repository. Empty maps nothing.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workload",
              "url"
            ],
            "properties": {
              "workload": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?/[A-Za-z]+/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "description": "namespace/Kind/name of the controller, e.g. shop/Deployment/shop-api."
              },
              "url": {
                "type": "string",
                "pattern": "^https?://[^/]+/.+",
                "description": "The repository to clone and open the PR against. Its host must be in allowedRepositoryHosts."
              },
              "defaultBranch": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "allowedRepositoryHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.-]+(:[0-9]+)?$"
          }
        },
        "eligibleCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Primary-finding categories that may start a coder. image is deliberately never a default."
        },
        "confidenceFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perPlanUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perImplementUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perDayUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "attemptsPerRepositoryPerDay": {
              "type": "integer",
              "minimum": 1
            },
            "concurrentJobs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deadlines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
              "description": "Plan Job deadline. .NET TimeSpan (hh:mm:ss), not Go duration. Must exceed four minutes."
            },
            "implement": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
              "description": "Implement Job deadline. .NET TimeSpan, must exceed four minutes."
            },
            "approvalTimeout": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
              "description": "A plan nobody decided on expires after this. d.hh:mm:ss for days."
            },
            "jobTtl": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
              "description": "ttlSecondsAfterFinished for coder Jobs."
            },
            "pollInterval": {
              "type": "string",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
              "description": "How often the watcher polls Job status."
            }
          }
        },
        "workspaceSize": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per coder pod. Declared, not free-form: these bind to CodeFix:Resources, not to a Kubernetes resources block.",
          "properties": {
            "cpuRequest": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?m?$",
              "description": "Kubernetes CPU quantity, e.g. \"1\" or \"500m\"."
            },
            "memoryRequest": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            },
            "cpuLimit": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?m?$",
              "description": "Kubernetes CPU quantity, e.g. \"1\" or \"500m\"."
            },
            "memoryLimit": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            }
          }
        },
        "requireGreenBuild": {
          "type": "boolean"
        },
        "allowUnauthenticatedApproval": {
          "type": "boolean",
          "description": "Throwaway e2e clusters only: lets mode pr run with auth off."
        },
        "sdk": {
          "enum": [
            "real",
            "fake"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:\\[\\]-]*$"
        },
        "gh": {
          "enum": [
            "",
            "shim"
          ]
        },
        "egressProxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "description": "The squid image. Pinned.",
              "required": [
                "repository"
              ],
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string",
                  "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$"
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "allowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.?[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*$",
                "description": "squid dstdomain: '.example.com' matches the domain and every subdomain, 'example.com' only itself."
              }
            },
            "extraAllowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.?[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*$",
                "description": "squid dstdomain: '.example.com' matches the domain and every subdomain, 'example.com' only itself."
              }
            }
          }
        },
        "nugetCache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Independent of the top-level networkPolicy.enabled."
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "embedded": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
