    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sidecarLabel": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraIngressCIDRs": {
          "description": "Every entry here can forge an alert to an unauthenticated, incident-creating endpoint.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
          }
        },
        "egress": {
          "type": "object",
          "description": "OFF by default. Enabling this denies everything not listed, including DNS and the API server.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dns": {
              "type": "boolean"
            },
            "apiServerCIDRs": {
              "description": "The API server is an endpoint, not a selectable pod. Without this the agent cannot watch, read events or act.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
              }
            },
            "apiServerPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extraEgressCIDRs": {
              "description": "The LLM API and the notification endpoints. Empty means no escalation can reach a person.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9.]+/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
              }
            },
            "extraEgressPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "nodeRole": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "description": "Extra env vars, appended last. Reserved names are refused in _helpers.tpl.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "description": "Extra envFrom sources (configMapRef / secretRef).",
      "items": {
        "type": "object"
      }
    },
    "grafana": {
      "type": "object",
      "description": "Grafana's own HTTP API, for incident annotations. Separate from grafanaMcp: that is the MCP server the model queries THROUGH, this is the API the agent writes to.",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Empty disables annotation entirely."
        }
      }
    },
    "webhookPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Port for /webhooks. 0 keeps everything on 8080. When set, the console and API answer only on 8080 and the webhook only here, so a NetworkPolicy can protect the receiver without deciding who may read the console."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "OIDC for the console and API. Fails closed: if the IdP is unreachable the agent is unavailable.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authority": {
          "type": "string",
          "description": "The OIDC issuer. Required when enabled."
        },
        "clientId": {
          "type": "string"
        },
        "rolesClaim": {
          "type": "string"
        },
        "readerRole": {
          "type": "string",
          "description": "Empty means any authenticated user."
        },
        "approverRole": {
          "type": "string",
          "description": "Empty means any authenticated user may approve a cluster change."
        }
      }
    },
    "cluster": {
      "type": "object",
      "description": "The cluster this agent runs in. cluster.name is required at render time: the value of the `cluster` label on this cluster's metrics and logs.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Required. In every signal fingerprint and every query the model writes."
        }
      },
      "additionalProperties": false
    },
    "investigation": {
      "type": "object",
      "description": "What the model is told about this cluster.",
      "properties": {
        "inScopeNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Namespaces worth investigating, stated on the environment card. Empty says nothing about scope."
        },
        "job": {
          "type": "object",
          "description": "Investigation in a Job (v0.12.0 F5): the investigation's model loop runs as Claude Code in a Job, Hephaisto serves it the tools. Nothing renders unless enabled; needs codeFix.enabled.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "executor": {
              "enum": [
                "inprocess",
                "job",
                "InProcess",
                "Job"
              ],
              "description": "The env arm. The switch ConfigMap's investigationExecutor is the other; most restrictive wins."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "model": {
              "type": "string",
              "maxLength": 128
            },
            "sdk": {
              "enum": [
                "real",
                "fake"
              ]
            },
            "maxCostUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "deadline": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
            },
            "concurrentJobs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "jobsPerHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "overflow": {
              "type": "string",
              "enum": ["inprocess", "wait"]
            },
            "fallbackToInProcess": {
              "type": "boolean"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "description": "Model prices. The agent refuses to start when a cost cap is set and the model has no price.",
      "properties": {
        "pricing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "inputPerMillionUsd",
              "outputPerMillionUsd"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "inputPerMillionUsd": {
                "type": "number",
                "minimum": 0
              },
              "outputPerMillionUsd": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "description": "The MCP endpoint (#157): coding agents and MCP gateways ask about incidents at /mcp on a port of its own. Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Its own port; not 8080, webhookPort or the Teams actions port."
        },
        "acceptIdentityProviderTokens": {
          "type": "boolean",
          "description": "With auth.enabled, accept the identity provider's bearer tokens too."
        },
        "maxResponseChars": {
          "type": "integer",
          "minimum": 4000,
          "maximum": 1000000
        },
        "requestsPerMinutePerToken": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                "description": "Also the key in secrets.mcp, and how the audit trail names a shared token (mcp/<name>)."
              },
              "role": {
                "type": "string",
                "enum": [
                  "reader",
                  "approver"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "shared",
                  "person"
                ],
                "description": "shared: a gateway's token, used for many people. person: one person's."
              },
              "subject": {
                "type": "string",
                "description": "For a person token: the person, as the console names them."
              },
              "mayWrite": {
                "type": "boolean"
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Namespaces admitted to the MCP port - a gateway's."
            },
            "fromCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "description": "GitHub issues as work (v0.14.0): an issue assigned to the agent's account, in a listed repository, is taken as a work item. Off by default.",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiBaseUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$",
          "description": "The REST API's root. https://api.github.com, or https://<host>/api/v3 for GitHub Enterprise Server."
        },
        "botLogin": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9-]*(\\[bot\\])?$",
          "description": "The account issues are assigned to. Empty means whoever the token belongs to."
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$",
          "description": "How often each repository is asked. .NET TimeSpan (hh:mm:ss), not Go duration. At least five seconds."
        },
        "issues": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
              },
              "description": "The authorization list: owner/repo. An issue in any other repository is never asked about."
            }
          }
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Who may answer a plan on the issue with /approve or /reject, by GitHub account number - never a login. Empty: nobody can answer by comment."
        },
        "useEgressProxy": {
          "type": "boolean",
          "description": "Send the agent's GitHub calls through codeFix.egressProxy when that proxy is rendered."
        },
        "planner": {
          "type": "object",
          "additionalProperties": false,
          "description": "The planner (v0.15.0): the open issues of one organisation project, walked through in the console. Off by default; needs github.enabled.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "owner": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9-]*$",
              "description": "The organisation the project belongs to: the <owner> of github.com/orgs/<owner>/projects/<number>."
            },
            "number": {
              "type": "integer",
              "minimum": 0,
              "description": "The project's number. 0 is 'not set'."
            },
            "requiredFields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Names of the board's fields an item should not leave empty."
            },
            "staleAfterDays": {
              "type": "integer",
              "minimum": 1,
              "description": "Days an open pull request may be quiet before its issue is put in front of a person."
            },
            "assignees": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
              },
              "description": "The logins an issue can be assigned to from the planner, besides the agent's own account."
            },
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
              },
              "description": "Where a new issue can be opened from the planner, as owner/repo; the first is the default. Empty: the board's repositories."
            },
            "triage": {
              "type": "object",
              "additionalProperties": false,
              "description": "Claude labels and analyses an issue when a person asks, in a coder Job. Needs codeFix.enabled.",
              "properties": {
                "enabled": { "type": "boolean" },
                "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 },
                "maxTurns": { "type": "integer", "minimum": 1, "maximum": 500 },
                "deadline": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "hh:mm:ss, between 2 minutes and 2 hours."
                },
                "maxConcurrentJobs": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
