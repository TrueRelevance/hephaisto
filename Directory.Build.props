<Project>

  <!-- Every project in this repo, including tests. Hephaisto targets a single
       framework deliberately: it is one pod, not a shipped library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CS1591 (missing XML doc) is noise for an application; the rest of the
         analyzer set is on because Core holds the safety-critical code. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- ===================================================================================
       Versioning: the git tag is the only source of truth.

       No version.json, no <VersionPrefix> to bump. MinVer asks git, so "what version is
       this" is answered identically on a laptop and in CI, and a release is `git tag v0.0.1`
       and nothing else. There is nothing to keep in sync, because there is only one number.

           tag v0.0.1        -> 0.0.1              + 0.0.1+<sha> informational
           main, 42 commits  -> 0.0.2-main.0.42    + ...+<sha>

       AssemblyVersion is pinned. It is the BINDING identity, not the release identity, and
       this is one pod rather than a shipped library: letting it move per commit would churn
       every assembly reference for no reader. The release identity lives in
       InformationalVersion, which is what /api/version and OTel service.version report.
       =================================================================================== -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>patch</MinVerAutoIncrement>

    <!-- The floor for the version being worked towards, and the ONE thing here that a human
         moves. MinVer auto-increments the PATCH, so after v0.5.0 it heads to 0.5.1 and every
         untagged build - and every rc that scripts/e2e/lib/build.sh derives from it - would be
         numbered 0.5.1 no matter what the release actually contains. v0.6.0 moves the label
         prefix to hephaisto.dev, which is a BREAKING change for any namespace already opted
         in; calling that a patch would be wrong about the one thing a version number is for.

         It was left at 0.5 for the whole of v0.6.0's development, which is exactly the trap
         the paragraph below warns about: the rc path in scripts/e2e/lib/build.sh would have
         cut v0.5.1-rc1 for the v0.6.0 release, and release.yml's own guard would then have
         refused to publish it - a permanent public tag with nothing behind it.

         Raise this when a milestone starts, not when it ships. It only sets a floor: once
         v0.6.0 is tagged MinVer reads the tag and this line stops mattering, until the next
         minor. -->
    <MinVerMinimumMajorMinor>0.15</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>main.0</MinVerDefaultPreReleaseIdentifiers>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/TrueRelevance/hephaisto</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Deterministic source paths in CI only. Turning this on locally would break the
       debugger's ability to find sources on this machine. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets=all: a build-time versioner, never a runtime dependency. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
