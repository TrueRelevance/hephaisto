# Development image, used by Tilt with live_update. Unlike ~/dev, this file IS tracked in
# git - a build file that exists only on one machine is how that workspace ended up with
# repos that cannot be rebuilt from a fresh clone.

FROM mcr.microsoft.com/dotnet/sdk:11.0

# The manifest pins runAsUser 64198, so everything below has to be owned by and writable by
# that uid. Restoring as root and then running as 64198 leaves a NuGet cache under /root the
# runtime user cannot read, which surfaces much later as an unrelated-looking restore error.
RUN useradd --uid 64198 --create-home --home-dir /home/hephaisto hephaisto \
 && mkdir -p /app \
 && chown -R 64198:64198 /app /home/hephaisto

USER 64198:64198
ENV HOME=/home/hephaisto \
    DOTNET_CLI_HOME=/home/hephaisto \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
WORKDIR /app

# --chown on every COPY: it defaults to uid 0 no matter what USER is set to, so without it
# the sources land root-owned and `dotnet restore` fails with a confusing
#   Access to the path '/app/src/Hephaisto.Core/obj' is denied
COPY --chown=64198:64198 Directory.Build.props Directory.Packages.props ./
COPY --chown=64198:64198 src/Hephaisto.Core/Hephaisto.Core.csproj                       src/Hephaisto.Core/
COPY --chown=64198:64198 src/Hephaisto.ServiceDefaults/Hephaisto.ServiceDefaults.csproj src/Hephaisto.ServiceDefaults/
COPY --chown=64198:64198 src/Hephaisto.Agent/Hephaisto.Agent.csproj                     src/Hephaisto.Agent/
RUN dotnet restore src/Hephaisto.Agent/Hephaisto.Agent.csproj

COPY --chown=64198:64198 src/ src/

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_ENVIRONMENT=Development \
    # No .git in here either, so MinVer would warn on every rebuild and stamp
    # 0.0.0-alpha.0. Say `dev` instead: a dev image reporting a version-shaped number is
    # how a dev image gets mistaken for a release in a screenshot.
    MinVerSkip=true \
    Version=0.0.0-dev \
    # The Tilt live_update syncs files in from the host, and inotify does not fire for
    # those writes inside the container. Without polling, dotnet watch silently never
    # reloads and you spend an afternoon debugging code that was never running.
    DOTNET_USE_POLLING_FILE_WATCHER=1 \
    DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1

EXPOSE 8080

ENTRYPOINT ["dotnet", "watch", "--project", "src/Hephaisto.Agent/Hephaisto.Agent.csproj", \
            "--non-interactive", "run", "--no-launch-profile"]
