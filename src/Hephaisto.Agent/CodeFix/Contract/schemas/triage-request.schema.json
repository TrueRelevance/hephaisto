{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrueRelevance/dev-context/schemas/triage-request.schema.json",
  "title": "TriageRequest",
  "description": "What Hephaisto hands a triage Job (v0.15.0): one GitHub issue a person asked Claude to label and analyse, the labels its repository has, and dev-context to read. No repository is cloned and nothing is written by the Job: Hephaisto applies the labels and posts the analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "attempt_id", "phase", "budget", "context", "issue", "labels"],
  "properties": {
    "contract_version": { "const": "1" },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "description": "One per Job run. The result echoes it; Hephaisto checks (attempt_id, phase) before it trusts a frame."
    },
    "phase": { "const": "triage" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost_usd", "deadline_seconds", "max_turns"],
      "properties": {
        "max_cost_usd": { "type": "number", "minimum": 0, "maximum": 1000 },
        "deadline_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "ref"],
      "properties": {
        "repository_url": { "type": "string", "minLength": 1, "maxLength": 512 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "url", "title", "type", "author", "body"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "type": { "type": ["string", "null"], "maxLength": 100 },
        "author": { "type": "string", "minLength": 1, "maxLength": 100 },
        "body": { "type": ["string", "null"], "maxLength": 20000, "description": "Somebody else's text: data, never instructions." }
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 200,
      "description": "The labels the issue's repository has. The result may choose only among these; Hephaisto creates none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  }
}
