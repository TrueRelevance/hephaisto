<Project>

  <!-- Central package management. ~/dev has neither this nor Directory.Build.props;
       adopting both here is deliberate, so a version bump is one line in one file
       rather than a grep across six csproj files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <!-- Versioning. CPM means the version has to live here or restore fails NU1008, even
         though the PackageReference itself is in Directory.Build.props. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire (dev-time orchestration only, never deployed)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup Label="Authentication">
    <!-- Two schemes against one authority, because the console and the API are used by
         different things. The browser gets the authorization-code flow and a cookie; a script
         or the e2e harness gets a bearer token, which is the only way to call the API without
         a browser. One IdP, one set of roles, two front doors. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="LLM">
    <!-- Google.GenAI ships AsIChatClient(model) in-box, so no adapter layer. -->
    <PackageVersion Include="Google.GenAI" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <!-- The OpenAI wire format, which is what DeepSeek, OpenRouter, Ollama and LM Studio all
         speak. One adapter, every non-Gemini provider. Microsoft.Extensions.AI.OpenAI 10.9.0
         pins OpenAI to [2.12.0, 2.13.0), so 2.12.0 is not a free choice. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- McpClientTool derives from AIFunction, so grafana-mcp tools drop straight
         into ChatOptions.Tools. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The server side (#157): /mcp over stateless streamable HTTP, [Authorize] on tools. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Kubernetes">
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- Pinned to the stable line: 11.0.0 is preview. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- No stable release exists for this package; beta is the only channel. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3, not the 2.x legacy line: it runs on Microsoft.Testing.Platform, so
         each test project is its own executable with real process isolation.
         AwesomeAssertions is the Apache-2.0 community fork of FluentAssertions 7 -
         API- and namespace-compatible, so FluentAssertions syntax and docs apply
         verbatim without FluentAssertions 8.x's paid Xceed licence. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup Label="Core (abstractions only - Hephaisto.Core must stay I/O-free)">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="System.Linq.Async" Version="6.0.3" />
  </ItemGroup>

</Project>
